<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Explore | Outpost</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    


    <main class="container py-5">
        <form
    action="/listings"
    method="GET"
    class="row justify-content-center mb-4"
>

    <div class="col-md-6">

        <input
            type="text"
            name="search"
            class="form-control"
            placeholder="Search cabins, camping, locations..."
            value="<%= search %>"
        >

    </div>

    <div class="col-md-2">

        <button
            type="submit"
            class="btn btn-primary w-100"
        >
            Search
        </button>

    </div>

</form>

        <div class="text-center mb-5">

            <h1>Explore Outpost</h1>

            <p class="text-muted">
                Discover unique outdoor experiences and rentals.
            </p>

        </div>


        <div class="row">

            <% listings.forEach(listing => { %>

                <div class="col-md-6 col-lg-4 mb-4">

                    <div class="card h-100 shadow-sm">

                        <img
                            src="<%= listing.image %>"
                            class="card-img-top"
                            alt="<%= listing.title %>"
                            style="height: 220px; object-fit: cover;"
                        >

                        <div class="card-body d-flex flex-column">

                            <h5 class="card-title">
                                <%= listing.title %>
                            </h5>

                            <p class="text-muted mb-2">
                                <%= listing.location %>
                            </p>

                            <p class="card-text">
                                <%= listing.description %>
                            </p>

                            <div class="mt-auto">

                                <h5>
                                    $<%= listing.price %>
                                </h5>

                                <a
                                    href="/listings/<%= listing._id %>"
                                    class="btn btn-primary"
                                >
                                    View Details
                                </a>

                            </div>

                        </div>

                    </div>

                </div>

            <% }) %>

        </div>

    </main>


    <%- include("../partials/footer") %>

</body>
</html>