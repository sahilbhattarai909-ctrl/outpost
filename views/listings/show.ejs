<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= listing.title %> | Outpost</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

    <%- include("../partials/navbar") %>


    <main class="container py-5">

        <div class="row">

            <!-- Listing Image -->

            <div class="col-md-7">

                <img
                    src="<%= listing.image %>"
                    alt="<%= listing.title %>"
                    class="img-fluid rounded"
                >

            </div>


            <!-- Listing Information -->

            <div class="col-md-5">

                <h1>
                    <%= listing.title %>
                </h1>

                <p class="text-muted">
                    <%= listing.location %>
                </p>

                <hr>

                <p>
                    <%= listing.description %>
                </p>

                <h3>
                    $<%= listing.price %>
                </h3>

                <p>
                    Category:
                    <strong>
                        <%= listing.category %>
                    </strong>
                </p>


                <% if (listing.available) { %>

                    <button class="btn btn-success">
                        Available
                    </button>

                <% } else { %>

                    <button
                        class="btn btn-secondary"
                        disabled
                    >
                        Not Available
                    </button>

                <% } %>

                <br><br>

                <a
                    href="/listings"
                    class="btn btn-outline-primary"
                >
                    Back to Listings
                </a>

            </div>

        </div>

    </main>


    <%- include("../partials/footer") %>


    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>

</html>