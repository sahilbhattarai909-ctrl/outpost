<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Outpost | Outdoor Experiences</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

    <%- include("partials/navbar") %>


    <!-- Hero -->

    <section class="hero">

        <div class="container">

            <div class="hero-content">

                <h1>
                    Find Your Next Adventure
                </h1>

                <p class="my-4">
                    Discover unique cabins, campsites,
                    and outdoor experiences.
                </p>

                <a
                    href="/listings"
                    class="btn btn-light btn-lg px-4"
                >
                    Explore Experiences
                </a>

            </div>

        </div>

    </section>


    <!-- Features -->

    <section class="container py-5">

        <div class="text-center mb-5">

            <h2 class="fw-bold">
                Why Outpost?
            </h2>

            <p class="text-muted">
                Everything you need for your next outdoor escape.
            </p>

        </div>


        <div class="row g-4">

            <div class="col-md-4">

                <div class="card h-100 p-4 text-center">

                    <div class="fs-1 mb-3">
                        🏕️
                    </div>

                    <h4>
                        Unique Stays
                    </h4>

                    <p class="text-muted">
                        Discover cabins, campsites, and
                        unique outdoor accommodations.
                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="card h-100 p-4 text-center">

                    <div class="fs-1 mb-3">
                        🏔️
                    </div>

                    <h4>
                        Amazing Adventures
                    </h4>

                    <p class="text-muted">
                        Find experiences that take you
                        beyond the ordinary.
                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="card h-100 p-4 text-center">

                    <div class="fs-1 mb-3">
                        🌲
                    </div>

                    <h4>
                        Explore Nature
                    </h4>

                    <p class="text-muted">
                        Connect with nature and create
                        unforgettable memories.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <%- include("partials/footer") %>


    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>

</html>